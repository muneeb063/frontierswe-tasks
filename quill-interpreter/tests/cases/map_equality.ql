print({"a": 1, "b": 2} == {"b": 2, "a": 1});
print({"a": [1, 2]} == {"a": [1, 2]}, {"a": [1, 2]} == {"a": [2, 1]});
print([1, [2, {"x": nil}]] == [1, [2, {"x": nil}]]);
print(1 == true, 0 == false, nil == false, "1" == 1, [] == {}, [] == []);
print({1: "a"} == {true: "a"}, {} != {}, [1] != [1, 1]);
print("abc" == "abc", "abc" != "abd", 10 == 10, -0 == 0);
