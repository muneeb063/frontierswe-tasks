     "Resource": "*"
    }
   ]
  },
  "srn:stratus:iam::111122223333:policy/ReadOnly": {
   "Version": "2024-01-01",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": [
      "storage:Get*",
      "storage:List*",
      "compute:Describe*",
      "db:Query",
      "db:Scan",
      "logs:Get*",
      "iam:Get*",
      "iam:List*"
     ],
     "Resource": "*"
    }
   ]
  },
  "srn:stratus:iam::111122223333:policy/DevBoundary": {
   "Version": "2024-01-01",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": [
      "storage:*",
      "compute:*",
      "db:*",
      "logs:*",
      "kms:Decrypt",
      "kms:GenerateDataKey"
     ],
     "Resource": "*"
    },
    {
     "Effect": "Allow",
     "Action": [
      "iam:GetUser",
      "iam:CreateAccessKey"
     ],
     "Resource": "srn:stratus:iam::111122223333:user/${stratus:username}"
    }
   ]
  },
  "srn:stratus:iam::111122223333:policy/HomeFolder": {
   "Version": "2024-01-01",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": [
      "storage:GetObject",
      "storage:PutObject",
      "storage:DeleteObject"
     ],
     "Resource": "srn:stratus:storage:::home/${stratus:username}/*"
    },
    {
     "Effect": "Allow",
     "Action": "storage:ListBucket",
     "Resource": "srn:stratus:storage:::home",
     "Condition": {
      "StringLike": {
       "stratus:prefix": [
        "${stratus:username}/*",
        "${stratus:username}"
       ]
      }
     }
    }
   ]
  },
  "srn:stratus:iam::111122223333:policy/TeamABAC": {
   "Version": "2024-01-01",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": [
      "compute:StartInstance",
      "compute:StopInstance",
      "compute:CreateSnapshot"
     ],
     "Resource": "srn:stratus:compute:eu-west-1:111122223333:instance/*",
     "Condition": {
      "StringEquals": {
       "stratus:ResourceTag/team": "${stratus:PrincipalTag/team}"
      }
     }
    },
    {
     "Effect": "Allow",
     "Action": "compute:DescribeInstances",
     "Resource": "*"
    }
   ]
  },
  "srn:stratus:iam::111122223333:policy/RequireMFA": {
   "Version": "2024-01-01",
   "Statement": [
    {
     "Effect": "Deny",
     "Action": [
      "compute:TerminateInstance",
      "storage:DeleteObject",
      "db:DeleteTable",
      "logs:DeleteLogGroup",
      "iam:DeleteUser"
     ],
     "Resource": "*",
     "Condition": {
      "BoolIfExists": {
       "stratus:MultiFactorAuthPresent": false
      }
     }
    }
   ]
  },
  "srn:stratus:iam::111122223333:policy/OfficeOnly": {
   "Version": "2024-01-01",
   "Statement": [
    {
     "Effect": "Deny",
     "Action": "*",
     "Resource": "*",
     "Condition": {
      "NotIpAddress": {
       "stratus:SourceIp": [
